# ==============================================================================
# Environment Configuration - Smart Document Q&A Assistant
# Copy this file to '.env' and populate your free API keys as needed.
# Note: You can also enter API keys directly into the Streamlit sidebar at runtime.
# If no keys are provided, the app seamlessly runs in 100% Offline Local Mode!
# ==============================================================================

# 1. Google Gemini API (Free Tier: 15 RPM / 1M TPM)
# Obtain free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq API (Free Tier: Ultra-fast Llama-3.3-70B / Llama-3.1-8B)
# Obtain free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3. Optional Model Overrides & Vector Cache Directory
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTORSTORE_DIR=./vectorstore

